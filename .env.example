CLASSROOM_MODEL_PROVIDER=llama_cpp
CLASSROOM_MODEL=gemma4-e4b
CLASSROOM_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
CLASSROOM_OPENAI_API_KEY=local-no-key

# Used by scripts/start_model.py
CLASSROOM_MODEL_FILE=models/gemma-4-E4B_q4_0-it.gguf
CLASSROOM_LLAMA_HOST=127.0.0.1
CLASSROOM_LLAMA_PORT=8080
CLASSROOM_LLAMA_CONTEXT_SIZE=8192
CLASSROOM_LLAMA_PARALLEL=1

# Optional legacy Ollama adapter
OLLAMA_HOST=http://127.0.0.1:11434

# Restrict this in deployments. Comma-separated origins are accepted.
CLASSROOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Piper TTS component
CLASSROOM_PIPER_VOICE=voices/en_US-lessac-medium.onnx

# CPU-only face recognition: YuNet detection + SFace embeddings + cosine matching
CLASSROOM_FACE_DETECTOR_MODEL=models/vision/face_detection_yunet_2023mar.onnx
CLASSROOM_FACE_RECOGNIZER_MODEL=models/vision/face_recognition_sface_2021dec.onnx
CLASSROOM_FACE_COSINE_THRESHOLD=0.45
CLASSROOM_FACE_DATABASE=data/faces.sqlite3
