CLASSROOM_MODEL_PROVIDER=ollama
CLASSROOM_MODEL=gemma4:e4b
OLLAMA_HOST=http://127.0.0.1:11434

# Used when CLASSROOM_MODEL_PROVIDER=llama_cpp or openai_compatible
CLASSROOM_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
CLASSROOM_OPENAI_API_KEY=local-no-key

# Restrict this in deployments. Comma-separated origins are accepted.
CLASSROOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
